  action            String      @db.VarChar(120)
  entityType        String      @map("entity_type") @db.VarChar(120)
  entityId          String?     @map("entity_id") @db.Uuid
  metadata          Json        @default("{}") @db.JsonB
  occurredAt        DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor             Membership? @relation(fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(120)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(160)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, occurredAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}
