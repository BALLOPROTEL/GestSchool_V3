generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum RoleScope {
  SYSTEM
  TENANT

  @@map("role_scope")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("session_status")
}

enum PersonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("person_status")
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED

  @@map("academic_year_status")
}

enum AcademicRecordStatus {
  ACTIVE
  ARCHIVED

  @@map("academic_record_status")
}

enum AcademicPeriodType {
  TRIMESTER
  SEMESTER

  @@map("academic_period_type")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  COMPLETED

  @@map("enrollment_status")
}

enum EnrollmentType {
  NEW
  RE_ENROLLMENT
  TRANSFER

  @@map("enrollment_type")
}

enum EnrollmentEventKind {
  BASELINE
  CREATED
  UPDATED
  CONFIRMED
  CANCELLED
  TRANSFERRED
  COMPLETED

  @@map("enrollment_event_kind")
}

enum AcademicWorkflowStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  PUBLISHED
  LOCKED

  @@map("academic_workflow_status")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID

  @@map("invoice_status")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED

  @@map("payment_status")
}

enum CashSessionStatus {
  OPEN
  CLOSED

  @@map("cash_session_status")
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED

  @@map("document_status")
}

enum MessageStatus {
  DRAFT
  SENT

  @@map("message_status")
}

enum NotificationStatus {
  UNREAD
  READ

  @@map("notification_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_status")
}

model Tenant {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug              String             @unique @db.VarChar(80)
  name              String             @db.VarChar(160)
  status            TenantStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  settings          TenantSetting?
  memberships       Membership[]
  roles             Role[]
  sessions          Session[]
  students          Student[]
  guardians         Guardian[]
  teachers          Teacher[]
  academicYears     AcademicYear[]
  levels            Level[]
  subjects          Subject[]
  feeTypes          FeeType[]
  documentTemplates DocumentTemplate[]
  auditLogs         AuditLog[]
  outboxEvents      OutboxEvent[]

  @@map("tenants")
}

model TenantSetting {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  defaultCurrency String   @default("XOF") @map("default_currency") @db.Char(3)
  defaultLocale   String   @default("fr") @map("default_locale") @db.VarChar(10)
  timezone        String   @default("Africa/Abidjan") @db.VarChar(80)
  values          Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

model User {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email       String        @unique @db.VarChar(254)
  displayName String        @map("display_name") @db.VarChar(160)
  disabledAt  DateTime?     @map("disabled_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  sessions    Session[]
  students    Student[]
  guardians   Guardian[]
  teachers    Teacher[]
  identity    AuthIdentity?
  authTokens  AuthToken[]
  iamAudit    IamAuditLog[]

  @@map("users")
}

model Membership {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  status           MembershipStatus    @default(ACTIVE)
  joinedAt         DateTime            @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles            MembershipRole[]
  gradeChanges     GradeChange[]
  invoiceChanges   InvoiceAdjustment[]
  cashOpened       CashSession[]       @relation("CashSessionOpenedBy")
  cashClosed       CashSession[]       @relation("CashSessionClosedBy")
  sentMessages     Message[]           @relation("MessageSender")
  receivedMessages Message[]           @relation("MessageRecipient")
  notifications    Notification[]
  auditLogs        AuditLog[]
  authSessions     Session[]
  enrollmentEvents EnrollmentEvent[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@unique([tenantId, id, userId])
  @@index([tenantId, status])
  @@map("memberships")
}

model Role {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String?          @map("tenant_id") @db.Uuid
  code        String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  scope       RoleScope
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String           @db.VarChar(240)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String      @map("role_id") @db.Uuid
  permissionId String      @map("permission_id") @db.Uuid
  tenantId     String?     @map("tenant_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  scope        AccessScope @default(NONE)
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model MembershipRole {
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([tenantId])
  @@map("membership_roles")
}

model Session {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String?        @map("tenant_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  tokenHash     String         @unique @map("token_hash") @db.VarChar(128)
  status        SessionStatus  @default(ACTIVE)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  membershipId  String?        @map("membership_id") @db.Uuid
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  ipAddress     String?        @map("ip_address") @db.VarChar(64)
  lastUsedAt    DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  mfaVerifiedAt DateTime?      @map("mfa_verified_at") @db.Timestamptz(6)
  membership    Membership?    @relation(fields: [tenantId, membershipId, userId], references: [tenantId, id, userId], onDelete: Restrict)
  refreshTokens RefreshToken[]
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tenantId, createdAt])
  @@map("sessions")
}

enum AccessScope {
  PLATFORM
  TENANT
  ASSIGNED
  CHILDREN
  OWN
  NONE

  @@map("access_scope")
}

enum AuthTokenPurpose {
  ACTIVATION
  PASSWORD_RESET
  MFA_LOGIN
  MFA_ENROLL

  @@map("auth_token_purpose")
}

model AuthIdentity {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String?   @map("password_hash")
  activatedAt       DateTime? @map("activated_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  mfaSecret         String?   @map("mfa_secret")
  mfaEnabledAt      DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)
  mfaLastCounter    BigInt    @default(-1) @map("mfa_last_counter")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_identities")
}

model AuthToken {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  purpose         AuthTokenPurpose
  membershipId    String?          @map("membership_id") @db.Uuid
  encryptedSecret String?          @map("encrypted_secret")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?        @map("used_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("auth_tokens")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

model IamAuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  action     String   @db.VarChar(120)
  subjectId  String?  @map("subject_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([userId, occurredAt])
  @@map("iam_audit_logs")
}

model Student {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  userId      String?           @map("user_id") @db.Uuid
  matricule   String            @db.VarChar(40)
  firstName   String            @map("first_name") @db.VarChar(100)
  lastName    String            @map("last_name") @db.VarChar(100)
  birthDate   DateTime?         @map("birth_date") @db.Date
  status      PersonStatus      @default(ACTIVE)
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians   StudentGuardian[]
  enrollments Enrollment[]
  grades      Grade[]
  reportCards ReportCard[]
  invoices    Invoice[]
  payments    Payment[]
  documents   Document[]

  @@unique([tenantId, matricule])
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("students")
}

model Guardian {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  userId            String?           @map("user_id") @db.Uuid
  guardianReference String            @map("guardian_reference") @db.VarChar(40)
  firstName         String            @map("first_name") @db.VarChar(100)
  lastName          String            @map("last_name") @db.VarChar(100)
  phone             String?           @db.VarChar(30)
  email             String?           @db.VarChar(254)
  status            PersonStatus      @default(ACTIVE)
  archivedAt        DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students          StudentGuardian[]

  @@unique([tenantId, guardianReference])
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("guardians")
}

model StudentGuardian {
  tenantId              String   @map("tenant_id") @db.Uuid
  studentId             String   @map("student_id") @db.Uuid
  guardianId            String   @map("guardian_id") @db.Uuid
  relationship          String   @db.VarChar(60)
  isPrimary             Boolean  @default(false) @map("is_primary")
  isFinancialContact    Boolean  @default(false) @map("is_financial_contact")
  receivesNotifications Boolean  @default(true) @map("receives_notifications")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  student               Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  guardian              Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, studentId, guardianId])
  @@index([tenantId, guardianId])
  @@map("student_guardians")
}

model Teacher {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  userId         String?              @map("user_id") @db.Uuid
  employeeNumber String               @map("employee_number") @db.VarChar(40)
  firstName      String               @map("first_name") @db.VarChar(100)
  lastName       String               @map("last_name") @db.VarChar(100)
  status         PersonStatus         @default(ACTIVE)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments    TeachingAssignment[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("teachers")
}

model AcademicYear {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  code         String             @db.VarChar(30)
  name         String             @db.VarChar(100)
  startsOn     DateTime           @map("starts_on") @db.Date
  endsOn       DateTime           @map("ends_on") @db.Date
  status       AcademicYearStatus @default(DRAFT)
  archivedAt   DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  periods      AcademicPeriod[]
  classes      SchoolClass[]
  feeSchedules FeeSchedule[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("academic_years")
}

model AcademicPeriod {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  name           String               @db.VarChar(100)
  type           AcademicPeriodType
  status         AcademicRecordStatus @default(ACTIVE)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(6)
  ordinal        Int                  @db.SmallInt
  startsOn       DateTime             @map("starts_on") @db.Date
  endsOn         DateTime             @map("ends_on") @db.Date
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicYear   AcademicYear         @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  assignments    TeachingAssignment[]
  assessments    Assessment[]
  reportCards    ReportCard[]

  @@unique([tenantId, academicYearId, ordinal])
  @@unique([tenantId, id])
  @@unique([tenantId, id, academicYearId])
  @@index([tenantId, academicYearId])
  @@map("academic_periods")
}

model Level {
  id         String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  code       String               @db.VarChar(30)
  name       String               @db.VarChar(100)
  position   Int                  @default(0)
  status     AcademicRecordStatus @default(ACTIVE)
  archivedAt DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classes    SchoolClass[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("levels")
}

model SchoolClass {
  id                   String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  academicYearId       String               @map("academic_year_id") @db.Uuid
  levelId              String               @map("level_id") @db.Uuid
  code                 String               @db.VarChar(40)
  name                 String               @db.VarChar(120)
  capacity             Int?
  status               AcademicRecordStatus @default(ACTIVE)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicYear         AcademicYear         @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  level                Level                @relation(fields: [tenantId, levelId], references: [tenantId, id], onDelete: Restrict)
  subjects             ClassSubject[]
  enrollments          Enrollment[]
  enrollmentEventsFrom EnrollmentEvent[]    @relation("EnrollmentEventFrom")
  enrollmentEventsTo   EnrollmentEvent[]    @relation("EnrollmentEventTo")
  reportCards          ReportCard[]

  @@unique([tenantId, academicYearId, code])
  @@unique([tenantId, id])
  @@unique([tenantId, id, academicYearId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, levelId])
  @@map("school_classes")
}

model Subject {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  code        String               @db.VarChar(30)
  name        String               @db.VarChar(120)
  status      AcademicRecordStatus @default(ACTIVE)
  archivedAt  DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classes     ClassSubject[]
  reportLines ReportCardLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("subjects")
}

model ClassSubject {
  id            String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  schoolClassId String               @map("school_class_id") @db.Uuid
  subjectId     String               @map("subject_id") @db.Uuid
  coefficient   Decimal              @default(1) @db.Decimal(5, 2)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  schoolClass   SchoolClass          @relation(fields: [tenantId, schoolClassId], references: [tenantId, id], onDelete: Restrict)
  subject       Subject              @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  assignments   TeachingAssignment[]
  assessments   Assessment[]

  @@unique([tenantId, schoolClassId, subjectId])
  @@unique([tenantId, id])
  @@index([tenantId, schoolClassId])
  @@map("class_subjects")
}

model TeachingAssignment {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  classSubjectId   String               @map("class_subject_id") @db.Uuid
  teacherId        String               @map("teacher_id") @db.Uuid
  academicPeriodId String               @map("academic_period_id") @db.Uuid
  status           AcademicRecordStatus @default(ACTIVE)
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
