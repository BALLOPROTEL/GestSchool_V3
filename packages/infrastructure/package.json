{
  "name": "@gestschool/infrastructure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@aws-sdk/client-s3": "3.1126.0",
    "@gestschool/contracts": "workspace:*",
    "@gestschool/config": "workspace:*",
    "bullmq": "6.3.4",
    "playwright": "1.62.1",
    "qrcode": "1.5.4",
    "pg": "8.23.0",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/pg": "8.23.1",
    "vitest": "5.0.0"
  }
}
