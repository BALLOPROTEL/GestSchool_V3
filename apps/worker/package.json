{
  "name": "@gestschool/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./documents": {
      "types": "./dist/jobs/documents-generation.d.ts",
      "default": "./dist/jobs/documents-generation.js"
    },
    "./documents-runtime": {
      "types": "./dist/jobs/documents-runtime.d.ts",
      "default": "./dist/jobs/documents-runtime.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:messaging": "node --env-file=../../.env.example --env-file-if-exists=../../.env --import tsx tests/messaging-integration.ts"
  },
  "dependencies": {
    "@gestschool/contracts": "workspace:*",
    "@gestschool/database": "workspace:*",
    "@gestschool/config": "workspace:*",
    "@gestschool/infrastructure": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
