# Local development values only — never reuse them outside a developer workstation
NODE_ENV=development
API_PORT=3100

# IAM: generate local keys with pnpm iam:keys; no passwords or tokens in this file.
IAM_ENV=local
IAM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:3100
# Staging/production: IAM_ENV=staging|production, explicit HTTPS origins and secrets manager:
# IAM_JWT_PRIVATE_KEY (Ed25519 PKCS8 PEM), IAM_JWT_PUBLIC_KEY (SPKI PEM)
# IAM_MFA_KEYS_JSON (key-id -> base64 32-byte encryption key), IAM_MFA_KEY_ID
# IAM_CSRF_KEY (independent base64 32-byte HMAC key)

POSTGRES_DB=gestschool
POSTGRES_USER=gestschool
POSTGRES_PASSWORD=gestschool-local-only
DATABASE_URL=postgresql://gestschool:gestschool-local-only@127.0.0.1:5432/gestschool

REDIS_PASSWORD=gestschool-local-redis
REDIS_URL=redis://:gestschool-local-redis@127.0.0.1:6379

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=gestschool-local-private
S3_ACCESS_KEY_ID=gestschool-local
S3_SECRET_ACCESS_KEY=gestschool-local-secret
S3_FORCE_PATH_STYLE=true
