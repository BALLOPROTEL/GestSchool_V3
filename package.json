{
  "name": "gestschool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=10.24.0 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @gestschool/database... --filter @gestschool/infrastructure... build && node --env-file=.env.example --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "docker compose -f docker/compose.yml up -d --wait postgres redis minio && docker compose -f docker/compose.yml run --rm minio-init",
    "infra:down": "docker compose -f docker/compose.yml down --remove-orphans",
    "infra:logs": "docker compose -f docker/compose.yml logs -f postgres redis minio",
    "infra:reset": "docker compose -f docker/compose.yml down --volumes --remove-orphans",
    "infra:check": "pnpm --filter @gestschool/infrastructure... build && node --env-file=.env.example --env-file-if-exists=.env --import tsx scripts/infra-check.ts",
    "db:generate": "pnpm --filter @gestschool/database db:generate",
    "db:migrate": "pnpm --filter @gestschool/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @gestschool/database db:migrate:deploy",
    "db:reset": "pnpm --filter @gestschool/database db:reset",
    "db:seed": "pnpm --filter @gestschool/contracts build && pnpm --filter @gestschool/database db:seed",
    "db:studio": "pnpm --filter @gestschool/database db:studio",
    "db:test": "pnpm --filter @gestschool/database db:test",
    "iam:keys": "node scripts/iam-keys.mjs",
    "dev:access": "pnpm --filter @gestschool/api... build && TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --env-file=.env.example --env-file-if-exists=.env --import tsx apps/api/src/modules/iam/infrastructure/dev-access.ts",
    "dev:totp": "node --env-file=.env.example --env-file-if-exists=.env --import tsx apps/api/src/modules/iam/infrastructure/dev-totp.ts",
    "people:test": "pnpm --filter @gestschool/api... build && pnpm --filter @gestschool/api test:iam tests/people.test.ts",
    "academics:test": "pnpm --filter @gestschool/api... build && pnpm --filter @gestschool/api test:iam tests/academics.test.ts",
    "enrollments:test": "pnpm --filter @gestschool/api... build && pnpm --filter @gestschool/api test:iam tests/enrollments.test.ts",
    "finance:test": "pnpm --filter @gestschool/api... build && pnpm --filter @gestschool/api test:iam tests/finance.test.ts",
    "iam:dev": "pnpm --filter @gestschool/api... build && node --env-file=.env.example --env-file-if-exists=.env --import tsx apps/api/src/modules/iam/infrastructure/dev-cli.ts",
    "iam:test": "pnpm --filter @gestschool/api... build && pnpm --filter @gestschool/api test:iam"
  },
  "devDependencies": {
    "@gestschool/config": "workspace:*",
    "@gestschool/infrastructure": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "turbo": "2.10.12",
    "typescript": "6.0.2",
    "vitest": "5.0.0"
  }
}
